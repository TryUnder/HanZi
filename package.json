{
  "name": "hanzi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty",
    "preview": "vite preview",
    "audio:download": "node scripts/download-audio.mjs",
    "audio:download:force": "node scripts/download-audio.mjs --force",
    "audio:sync": "node scripts/download-audio-repository.mjs --sync-vocabulary",
    "audio:sync:hsk": "node scripts/download-audio-repository.mjs --category=hsk --sync-vocabulary",
    "audio:sync:syllables": "node scripts/download-audio-repository.mjs --category=syllables",
    "audio:sync:dry": "node scripts/download-audio-repository.mjs --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "cedict:parse": "node scripts/parse-cedict.mjs",
    "hsk:analyze": "node scripts/analyze-hsk-cedict.mjs",
    "vocabulary:build": "node scripts/build-vocabulary.mjs",
    "audio:sync:tones": "node scripts/sync-tone-audio.mjs",
    "audio:sync:all": "npm run audio:sync && npm run audio:download && npm run audio:sync:tones"
  },
  "dependencies": {
    "charsiu-js": "^0.2.0",
    "hanzi-writer": "^3.7.3",
    "lucide-react": "^1.66.0",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
